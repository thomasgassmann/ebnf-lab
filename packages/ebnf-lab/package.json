{
  "name": "ebnf-lab",
  "version": "0.1.0",
  "description": "EBNF grammar engine and React/Monaco editor",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thomasgassmann/ebnf-lab.git",
    "directory": "packages/ebnf-lab"
  },
  "type": "module",
  "sideEffects": [
    "./dist/ebnf-lab.css"
  ],
  "files": [
    "dist",
    "core.js",
    "core.d.ts",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./style.css": "./dist/ebnf-lab.css"
  },
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "pack:check": "npm pack --dry-run",
    "test": "vitest run"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.48.0",
    "tailwind-merge": "^3.7.0"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0",
    "@monaco-editor/react": "^4.7.0",
    "monaco-editor": ">=0.52.2 <1.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "@monaco-editor/react": "^4.7.0",
    "monaco-editor": "^0.57.0"
  }
}
